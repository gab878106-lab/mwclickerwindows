{
  "name": "mw-clicker-desktop",
  "version": "1.0.0",
  "description": "Version bureau de SKALA · MW Clicker",
  "main": "main.js",
  "author": "MW Clicker",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "fr.mwclicker.desktop",
    "productName": "SKALA - MW Clicker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "MW-clicker.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
